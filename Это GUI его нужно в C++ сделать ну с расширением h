<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>VV.EXE</title>
<style>
  :root {
    --accent: #475569;
    --accent-rgb: 71, 85, 105;
    --accent-bright: #64748b;
    --accent-dark: #1e293b;
    --win-bg: #ffffff;
    --win-bg-rgb: 255, 255, 255;
    --win-opacity: 0.94;
    --sidebar-bg: #fafafa;
    --sidebar-bg-rgb: 250, 250, 250;
    --panel-bg: #f4f4f5;
    --panel-bg-rgb: 244, 244, 245;
    --input-bg: #ffffff;
    --input-bg-rgb: 255, 255, 255;
    --border: rgba(0, 0, 0, 0.08);
    --border-strong: rgba(0, 0, 0, 0.14);
    --text: #18181b;
    --text-bright: #000000;
    --text-mid: #52525b;
    --text-dim: #71717a;
    --text-faint: #a1a1aa;
    --shadow: rgba(0, 0, 0, 0.08);
    --shadow-strong: rgba(0, 0, 0, 0.15);
    --good: #16a34a;
    --bad: #dc2626;
    --bad-rgb: 220, 38, 38;
    --warn: #d97706;
    --radius: 8px;
    --radius-sm: 5px;
    --radius-lg: 10px;
    --font-scale: 1;

    --feature-on-bg: #1a1a1a;
    --feature-on-bg-hover: #202020;
    --feature-on-border: #2e2e2e;
    --feature-on-border-hover: #3e3e3e;
    --feature-on-text: #f0f0f0;
    --feature-on-text-mid: #b8b8b8;
    --feature-on-text-dim: #8a8a8a;
    --feature-on-panel: rgba(0, 0, 0, 0.35);
    --feature-on-element: rgba(255, 255, 255, 0.06);
    --feature-on-element-border: #3a3a3a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: calc(12px * var(--font-scale)); }
  html, body {
    width: 100%; height: 100%;
    background: #0a0a0a;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
    overflow: hidden;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  body { font-size: 1rem; }

  .menu {
    position: absolute;
    top: 40px; left: 60px;
    width: 600px;
    height: 500px;
    background: rgba(var(--win-bg-rgb), var(--win-opacity));
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow:
      0 8px 32px var(--shadow-strong),
      0 2px 8px var(--shadow);
    z-index: 10;
    user-select: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: background .2s, border-radius .2s;
  }

  #particles-canvas {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 1;
    pointer-events: none;
    transition: opacity .4s;
  }
  #particles-canvas.hidden { opacity: 0; }

  .titlebar {
    position: relative;
    z-index: 2;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0;
    background: rgba(var(--sidebar-bg-rgb), 0.75);
    border-bottom: 1px solid var(--border);
    cursor: move;
    flex-shrink: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    height: 40px;
    backdrop-filter: blur(8px);
    transition: background .2s;
  }

  .titlebar h1 {
    font-size: 1rem; font-weight: 700;
    color: var(--text-bright);
    display: flex; align-items: center; gap: 11px;
    padding-left: 14px;
    letter-spacing: -0.02em;
  }
  .titlebar h1 .logo-mark {
    width: 24px; height: 24px;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent);
    border-radius: 6px;
    flex-shrink: 0;
    transition: background .2s;
  }
  .titlebar h1 .logo-mark svg {
    width: 15px; height: 15px;
    stroke: #ffffff; fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .titlebar h1 .title-text {
    display: flex; flex-direction: column;
    line-height: 1.05; gap: 1px;
  }
  .titlebar h1 .title-main {
    font-size: 0.958rem; font-weight: 800;
    letter-spacing: 0.5px; color: var(--text-bright);
  }
  .titlebar h1 .title-sub {
    font-size: 0.667rem; font-weight: 500;
    color: var(--text-dim);
    letter-spacing: 0.3px; text-transform: uppercase;
  }

  .titlebar .controls { display: flex; gap: 4px; padding-right: 8px; }
  .titlebar .min, .titlebar .close {
    width: 26px; height: 24px;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-dim); cursor: pointer;
    border-radius: 5px; transition: all .15s;
    background: transparent;
  }
  .titlebar .min svg, .titlebar .close svg {
    width: 0.917rem; height: 0.917rem;
    stroke: currentColor; fill: none;
    stroke-width: 2.2; stroke-linecap: round;
  }
  .titlebar .min:hover {
    background: rgba(var(--panel-bg-rgb), 0.7);
    color: var(--text);
  }
  .titlebar .close:hover { background: var(--bad); color: #ffffff; }

  .body { display: flex; flex: 1; min-height: 0; position: relative; z-index: 2; }

  .sidebar {
    width: 120px;
    background: rgba(var(--sidebar-bg-rgb), 0.55);
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column;
    padding: 8px 0; flex-shrink: 0;
    overflow-y: auto;
    backdrop-filter: blur(6px);
    transition: background .2s;
  }
  .sidebar::-webkit-scrollbar { width: 3px; }
  .sidebar::-webkit-scrollbar-thumb {
    background: var(--border-strong); border-radius: 2px;
  }

  .tab-btn {
    display: flex; align-items: center; gap: 9px;
    padding: 8px 12px;
    margin: 1px 8px;
    color: var(--text-dim);
    font-size: 0.875rem; font-weight: 500;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all .15s ease;
    position: relative; flex-shrink: 0;
  }
  .tab-btn:hover { color: var(--text); background: rgba(var(--accent-rgb), 0.06); }
  .tab-btn.active {
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.14);
    font-weight: 600;
  }
  .tab-btn.active .ico svg { stroke: var(--accent); }
  .tab-btn .ico {
    width: 15px; height: 15px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .tab-btn .ico svg {
    width: 1.083rem; height: 1.083rem;
    stroke: currentColor; stroke-width: 1.7; fill: none;
    stroke-linecap: round; stroke-linejoin: round;
    transition: stroke .15s;
  }
  .tab-btn .badge {
    position: absolute; right: 8px; top: 50%;
    transform: translateY(-50%);
    font-size: 0.667rem; font-weight: 700;
    background: var(--accent); color: #ffffff;
    padding: 1px 6px; border-radius: 8px;
    min-width: 18px; text-align: center;
  }
  .sidebar-sep {
    height: 1px; background: var(--border);
    margin: 8px 16px; flex-shrink: 0;
  }
  .sidebar-spacer { flex: 1; min-height: 6px; }

  .content {
    flex: 1; overflow-y: auto;
    min-width: 0;
    display: flex; flex-direction: column;
    background: rgba(var(--win-bg-rgb), 0.25);
    transition: background .2s;
  }
  .content::-webkit-scrollbar { width: 6px; }
  .content::-webkit-scrollbar-thumb {
    background: var(--border-strong); border-radius: 3px;
  }

  .tab-panel { display: none; flex: 1; min-height: 0; flex-direction: column; }
  .tab-panel.active { display: flex; }

  .features-wrap {
    flex: 1; overflow-y: auto;
    padding: 14px 16px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .features-wrap::-webkit-scrollbar { width: 6px; }
  .features-wrap::-webkit-scrollbar-thumb {
    background: var(--border-strong); border-radius: 3px;
  }

  .feature {
    background: rgba(var(--panel-bg-rgb), 0.55);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    backdrop-filter: blur(6px);
    transition: all .2s ease;
    overflow: hidden;
  }
  .feature:hover { border-color: rgba(var(--accent-rgb), 0.35); }

  .feature.on,
  .feature.expanded {
    background: var(--feature-on-bg);
    border-color: var(--feature-on-border);
  }
  .feature.on:hover,
  .feature.expanded:hover {
    background: var(--feature-on-bg-hover);
    border-color: var(--feature-on-border-hover);
  }
  .feature.on.expanded {
    background: var(--feature-on-bg);
    border-color: var(--accent);
  }

  .feature-head {
    display: flex; align-items: center;
    padding: 10px 12px;
    gap: 10px;
    cursor: pointer;
    transition: background .15s;
  }
  .feature-head:hover { background: rgba(var(--accent-rgb), 0.04); }
  .feature.on .feature-head:hover,
  .feature.expanded .feature-head:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .feature-gear {
    width: 22px; height: 22px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 4px;
    color: var(--text-dim);
    transition: all .15s;
    flex-shrink: 0;
    cursor: pointer;
  }
  .feature-gear svg {
    width: 13px; height: 13px;
    stroke: currentColor; fill: none;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    transition: transform .2s;
  }
  .feature-gear:hover {
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.1);
  }
  .feature.expanded .feature-gear svg { transform: rotate(90deg); }

  .feature.on .feature-gear,
  .feature.expanded .feature-gear {
    color: var(--feature-on-text-dim);
  }
  .feature.on .feature-gear:hover,
  .feature.expanded .feature-gear:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }
  .feature.on.expanded .feature-gear { color: var(--accent-bright); }

  .feature-name {
    flex: 1;
    font-size: 0.875rem;
    color: var(--text);
    font-weight: 500;
    transition: color .15s;
  }
  .feature.on .feature-name,
  .feature.expanded .feature-name {
    color: var(--feature-on-text);
  }
  .feature.on.expanded .feature-name {
    color: #ffffff;
    font-weight: 600;
  }

  .feature-status {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-faint);
    padding: 2px 8px;
    background: rgba(var(--panel-bg-rgb), 0.6);
    border-radius: 4px;
    font-variant-numeric: tabular-nums;
    transition: all .15s;
  }
  .feature-status.on {
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.12);
  }
  .feature.on .feature-status,
  .feature.expanded .feature-status {
    background: rgba(255, 255, 255, 0.08);
    color: var(--feature-on-text-dim);
  }
  .feature.on .feature-status.on,
  .feature.expanded .feature-status.on {
    background: rgba(var(--accent-rgb), 0.35);
    color: #ffffff;
  }

  .mini-sw {
    position: relative;
    width: 36px; height: 20px;
    background: rgba(var(--panel-bg-rgb), 0.7);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    cursor: pointer;
    transition: all .2s ease;
    flex-shrink: 0;
  }
  .mini-sw::before {
    content: '';
    position: absolute; top: 50%; left: 2px;
    transform: translateY(-50%);
    width: 14px; height: 14px;
    background: var(--text-faint);
    border-radius: 50%;
    transition: all .2s ease;
  }
  .mini-sw.on {
    background: var(--accent);
    border-color: var(--accent);
  }
  .mini-sw.on::before {
    left: calc(100% - 16px);
    background: #ffffff;
  }
  .feature.on .mini-sw,
  .feature.expanded .mini-sw {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--feature-on-element-border);
  }
  .feature.on .mini-sw::before,
  .feature.expanded .mini-sw::before {
    background: #a0a0a0;
  }
  .feature.on .mini-sw.on,
  .feature.expanded .mini-sw.on {
    background: var(--accent);
    border-color: var(--accent);
  }
  .feature.on .mini-sw.on::before,
  .feature.expanded .mini-sw.on::before {
    background: #ffffff;
  }

  .feature-settings {
    max-height: 0;
    overflow: hidden;
    transition: max-height .3s ease, background .2s;
    background: rgba(var(--win-bg-rgb), 0.2);
  }
  .feature.expanded .feature-settings {
    max-height: 800px;
    border-top: 1px solid var(--border);
  }
  .feature.on .feature-settings,
  .feature.expanded .feature-settings {
    background: var(--feature-on-panel);
    border-top-color: var(--feature-on-border);
  }
  .feature-settings-inner { padding: 10px 12px 12px; }

  .setting-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 0;
    font-size: 0.833rem;
    color: var(--text-mid);
    transition: color .15s;
  }
  .feature.on .setting-row,
  .feature.expanded .setting-row {
    color: var(--feature-on-text-mid);
  }

  .slider-row-cfg {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .slider-row-cfg:last-child { border-bottom: none; }
  .feature.on .slider-row-cfg,
  .feature.expanded .slider-row-cfg {
    border-bottom-color: var(--feature-on-border);
  }
  .slider-row-cfg .slider-head {
    display: flex; justify-content: space-between;
    font-size: 0.833rem; color: var(--text-mid);
    margin-bottom: 8px;
    transition: color .15s;
  }
  .feature.on .slider-row-cfg .slider-head,
  .feature.expanded .slider-row-cfg .slider-head {
    color: var(--feature-on-text-mid);
  }
  .slider-row-cfg .slider-head .val {
    color: var(--accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .feature.on .slider-row-cfg .slider-head .val,
  .feature.expanded .slider-row-cfg .slider-head .val {
    color: var(--accent-bright);
  }

  input[type=range] {
    width: 100%; height: 4px;
    -webkit-appearance: none;
    background: rgba(var(--panel-bg-rgb), 0.7);
    border-radius: 2px;
    outline: none;
    transition: background .2s;
  }
  .feature.on input[type=range],
  .feature.expanded input[type=range] {
    background: rgba(255, 255, 255, 0.1);
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px; height: 16px;
    background: var(--accent);
    border: 2px solid var(--win-bg);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 1px 4px var(--shadow-strong);
    transition: all .15s;
  }
  .feature.on input[type=range]::-webkit-slider-thumb,
  .feature.expanded input[type=range]::-webkit-slider-thumb {
    border-color: #1a1a1a;
  }
  input[type=range]::-webkit-slider-thumb:hover {
    background: var(--accent-bright);
    transform: scale(1.1);
  }
  input[type=range]::-moz-range-thumb {
    width: 16px; height: 16px;
    background: var(--accent);
    border: 2px solid var(--win-bg);
    border-radius: 50%;
    cursor: pointer;
  }

  .keybind {
    min-width: 66px;
    padding: 5px 10px;
    background: rgba(var(--input-bg-rgb), 0.7);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-mid);
    text-align: center;
    cursor: pointer;
    transition: all .15s;
    letter-spacing: 0.3px;
  }
  .feature.on .keybind,
  .feature.expanded .keybind {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--feature-on-element-border);
    color: var(--feature-on-text);
  }
  .keybind:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.05);
  }
  .feature.on .keybind:hover,
  .feature.expanded .keybind:hover {
    border-color: var(--accent);
    color: var(--accent-bright);
    background: rgba(var(--accent-rgb), 0.15);
  }
  .keybind.capturing {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.15);
    animation: pulse 1s infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.4); }
    50% { box-shadow: 0 0 0 4px rgba(var(--accent-rgb), 0.1); }
  }

  .section-group {
    font-size: 0.792rem;
    font-weight: 700;
    color: var(--text-mid);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding: 8px 4px 4px;
    margin-top: 4px;
  }
  .section-group:first-child { margin-top: 0; }

  .auction-header {
    padding: 14px 16px;
    background: rgba(var(--win-bg-rgb), 0.3);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    backdrop-filter: blur(4px);
  }
  .scan-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .scan-btn {
    display: flex; align-items: center; gap: 7px;
    padding: 8px 16px;
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    color: #ffffff;
    font-size: 0.875rem; font-weight: 600;
    cursor: pointer;
    transition: all .15s ease;
    font-family: inherit;
  }
  .scan-btn:hover {
    background: var(--accent-bright);
    border-color: var(--accent-bright);
    box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.2);
  }
  .scan-btn:active { transform: translateY(1px); }
  .scan-btn.scanning {
    background: var(--warn); border-color: var(--warn);
    pointer-events: none;
  }
  .scan-btn svg {
    width: 0.917rem; height: 0.917rem;
    stroke: currentColor; fill: none;
    stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round;
  }
  .scan-btn.scanning svg { animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .scan-info {
    flex: 1; display: flex; gap: 14px;
    font-size: 0.833rem; color: var(--text-dim);
  }
  .scan-info .stat b {
    color: var(--text); font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .scan-info .stat.hl b { color: var(--accent); }

  .progress-bar {
    height: 3px;
    background: rgba(var(--panel-bg-rgb), 0.6);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 6px;
  }
  .progress-bar .fill {
    height: 100%; width: 0%;
    background: var(--accent);
    border-radius: 2px;
    transition: width .3s;
  }

  .filters { display: flex; gap: 6px; margin-top: 10px; align-items: center; flex-wrap: wrap; }
  .filter-input {
    flex: 1; min-width: 100px;
    display: flex; align-items: center; gap: 6px;
    padding: 6px 10px;
    background: rgba(var(--input-bg-rgb), 0.7);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    transition: border-color .15s, box-shadow .15s;
    backdrop-filter: blur(4px);
  }
  .filter-input:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.1);
  }
  .filter-input svg {
    width: 0.917rem; height: 0.917rem;
    stroke: var(--text-dim); fill: none;
    stroke-width: 2; stroke-linecap: round;
    flex-shrink: 0;
  }
  .filter-input input {
    background: transparent; border: none; outline: none;
    color: var(--text); font-size: 0.875rem;
    width: 100%; font-family: inherit;
  }
  .filter-input input::placeholder { color: var(--text-faint); }

  .sort-select {
    padding: 6px 24px 6px 10px;
    background: rgba(var(--input-bg-rgb), 0.7) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2371717a' stroke-width='2' stroke-linecap='round'><polyline points='6 9 12 15 18 9'/></svg>") no-repeat right 6px center;
    background-size: 11px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text); font-size: 0.875rem;
    outline: none; cursor: pointer;
    appearance: none; -webkit-appearance: none;
    font-family: inherit;
    transition: border-color .15s;
    backdrop-filter: blur(4px);
  }
  .sort-select:hover, .sort-select:focus { border-color: var(--accent); }
  .sort-select option { background: var(--win-bg); color: var(--text); }

  .chk-small {
    display: flex; align-items: center; gap: 6px;
    padding: 6px 10px;
    background: rgba(var(--input-bg-rgb), 0.7);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 0.833rem;
    color: var(--text-mid);
    cursor: pointer;
    transition: all .15s;
    flex-shrink: 0;
    backdrop-filter: blur(4px);
  }
  .chk-small:hover { border-color: var(--accent); color: var(--text); }
  .chk-small .box {
    width: 13px; height: 13px;
    border: 1.5px solid var(--text-faint);
    border-radius: 3px;
    background: rgba(var(--input-bg-rgb), 0.8);
    position: relative; flex-shrink: 0;
  }
  .chk-small.on .box {
    background: var(--accent); border-color: var(--accent);
  }
  .chk-small.on .box::after {
    content: '';
    position: absolute;
    left: 3px; top: 0;
    width: 3px; height: 7px;
    border: solid #ffffff;
