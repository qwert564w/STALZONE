      border: 'rgba(139,92,246,0.18)', borderStrong: 'rgba(139,92,246,0.35)',
      text: '#e9e4ff', textBright: '#ffffff', textMid: '#c4b5fd', textDim: '#a78bfa', textFaint: '#7c3aed',
      shadow: 'rgba(0,0,0,0.5)', shadowStrong: 'rgba(0,0,0,0.7)'
    }
  };

  let customThemes = [];
  let currentTheme = { ...PRESETS.white };
  let currentThemeKey = 'white';

  function renderPresets() {
    const grid = document.getElementById('presetsGrid');
    grid.innerHTML = '';
    Object.entries(PRESETS).forEach(([key, theme]) => {
      grid.appendChild(makeSwatch(key, theme, false, key));
    });
    customThemes.forEach(ct => {
      grid.appendChild(makeSwatch(ct.name, ct.colors, true, ct.id));
    });
    grid.querySelectorAll('.preset-swatch').forEach(s => {
      if (s.dataset.themeKey === String(currentThemeKey)) s.classList.add('active');
    });
  }

  function makeSwatch(name, theme, isCustom, key) {
    const el = document.createElement('div');
    el.className = 'preset-swatch' + (isCustom ? ' custom' : '') + (theme.light ? ' light' : '');
    el.dataset.themeKey = key;
    el.style.background = theme.winBg;
    el.innerHTML = `
      <div class="swatch-bar" style="background:${theme.accent}"></div>
      <div class="swatch-preview">
        <span style="background:${theme.accent}"></span>
        <span style="background:${theme.panelBg}"></span>
        <span style="background:${theme.text}"></span>
      </div>
      <div class="swatch-name">${escapeHtml(name)}</div>
      ${isCustom ? '<div class="swatch-del" title="Удалить тему">×</div>' : ''}
    `;
    el.addEventListener('click', (e) => {
      if (e.target.classList.contains('swatch-del')) return;
      applyTheme(theme);
      currentThemeKey = key;
      document.querySelectorAll('.preset-swatch').forEach(s => s.classList.remove('active'));
      el.classList.add('active');
    });
    if (isCustom) {
      el.querySelector('.swatch-del').addEventListener('click', (e) => {
        e.stopPropagation();
        deleteCustomTheme(key);
      });
    }
    return el;
  }

  function createCustomTheme() {
    const name = document.getElementById('newThemeName').value.trim();
    if (!name) { showToast('Введи название темы', true); return; }
    if (customThemes.some(t => t.name.toLowerCase() === name.toLowerCase())) {
      showToast('Такое имя уже есть', true); return;
    }
    if (Object.keys(PRESETS).some(k => k.toLowerCase() === name.toLowerCase())) {
      showToast('Имя совпадает с пресетом', true); return;
    }
    const colors = {
      light: currentTheme.light,
      accent: document.getElementById('pickAccent').value,
      accentBright: currentTheme.accentBright,
      accentDark: currentTheme.accentDark,
      winBg: document.getElementById('pickWinBg').value,
      sidebarBg: document.getElementById('pickSidebar').value,
      panelBg: document.getElementById('pickPanel').value,
      inputBg: document.getElementById('pickWinBg').value,
      border: currentTheme.border,
      borderStrong: currentTheme.borderStrong,
      text: document.getElementById('pickText').value,
      textBright: currentTheme.textBright,
      textMid: currentTheme.textMid,
      textDim: currentTheme.textDim,
      textFaint: currentTheme.textFaint,
      shadow: currentTheme.shadow,
      shadowStrong: currentTheme.shadowStrong
    };
    const id = Date.now();
    customThemes.push({ id, name, colors });
    document.getElementById('newThemeName').value = '';
    renderPresets();
    showToast(`Тема "${name}" создана`, false);
  }

  function deleteCustomTheme(id) {
    const t = customThemes.find(x => x.id === id);
    customThemes = customThemes.filter(x => x.id !== id);
    if (currentThemeKey === id) currentThemeKey = null;
    renderPresets();
    showToast(`Тема "${t ? t.name : ''}" удалена`, false);
  }

  function applyTheme(theme) {
    currentTheme = { ...theme };
    setCSSVar('--accent', theme.accent);
    setCSSVar('--accent-rgb', hexToRgbTuple(theme.accent));
    setCSSVar('--accent-bright', theme.accentBright);
    setCSSVar('--accent-dark', theme.accentDark);
    setCSSVar('--win-bg', theme.winBg);
    setCSSVar('--win-bg-rgb', hexToRgbTuple(theme.winBg));
    setCSSVar('--sidebar-bg', theme.sidebarBg);
    setCSSVar('--sidebar-bg-rgb', hexToRgbTuple(theme.sidebarBg));
    setCSSVar('--panel-bg', theme.panelBg);
    setCSSVar('--panel-bg-rgb', hexToRgbTuple(theme.panelBg));
    setCSSVar('--input-bg', theme.inputBg);
    setCSSVar('--input-bg-rgb', hexToRgbTuple(theme.inputBg));
    setCSSVar('--border', theme.border);
    setCSSVar('--border-strong', theme.borderStrong);
    setCSSVar('--text', theme.text);
    setCSSVar('--text-bright', theme.textBright);
    setCSSVar('--text-mid', theme.textMid);
    setCSSVar('--text-dim', theme.textDim);
    setCSSVar('--text-faint', theme.textFaint);
    setCSSVar('--shadow', theme.shadow);
    setCSSVar('--shadow-strong', theme.shadowStrong);

    setColorInput('pickAccent', 'fillAccent', 'hexAccent', theme.accent);
    setColorInput('pickWinBg', 'fillWinBg', 'hexWinBg', theme.winBg);
    setColorInput('pickSidebar', 'fillSidebar', 'hexSidebar', theme.sidebarBg);
    setColorInput('pickPanel', 'fillPanel', 'hexPanel', theme.panelBg);
    setColorInput('pickText', 'fillText', 'hexText', theme.text);
  }

  function setCSSVar(name, val) {
    document.documentElement.style.setProperty(name, val);
  }

  function hexToRgbTuple(hex) {
    return `${parseInt(hex.slice(1,3),16)}, ${parseInt(hex.slice(3,5),16)}, ${parseInt(hex.slice(5,7),16)}`;
  }

  function setColorInput(inputId, fillId, hexId, hex) {
    const inp = document.getElementById(inputId);
    const fill = document.getElementById(fillId);
    const hexView = document.getElementById(hexId);
    if (inp) inp.value = hex;
    if (fill) fill.style.background = hex;
    if (hexView) hexView.textContent = hex.toUpperCase();
  }

  function applyCustomAccent(hex) {
    currentTheme.accent = hex;
    setCSSVar('--accent', hex);
    setCSSVar('--accent-rgb', hexToRgbTuple(hex));
    document.getElementById('fillAccent').style.background = hex;
    document.getElementById('hexAccent').textContent = hex.toUpperCase();
    document.querySelectorAll('.preset-swatch').forEach(s => s.classList.remove('active'));
    currentThemeKey = null;
  }

  function applyCustomColor(which, hex) {
    const map = {
      winBg: { var: '--win-bg', rgb: '--win-bg-rgb', fill: 'fillWinBg', hex: 'hexWinBg', key: 'winBg' },
      sidebar: { var: '--sidebar-bg', rgb: '--sidebar-bg-rgb', fill: 'fillSidebar', hex: 'hexSidebar', key: 'sidebarBg' },
      panel: { var: '--panel-bg', rgb: '--panel-bg-rgb', fill: 'fillPanel', hex: 'hexPanel', key: 'panelBg' },
      text: { var: '--text', rgb: null, fill: 'fillText', hex: 'hexText', key: 'text' }
    };
    const cfg = map[which];
    setCSSVar(cfg.var, hex);
    if (cfg.rgb) setCSSVar(cfg.rgb, hexToRgbTuple(hex));
    document.getElementById(cfg.fill).style.background = hex;
    document.getElementById(cfg.hex).textContent = hex.toUpperCase();
    currentTheme[cfg.key] = hex;
    document.querySelectorAll('.preset-swatch').forEach(s => s.classList.remove('active'));
    currentThemeKey = null;
  }

  function applyOpacity(val) {
    setCSSVar('--win-opacity', parseFloat(val) / 100);
    document.getElementById('valOpacity').textContent = val + '%';
  }

  function applyRadius(val) {
    const v = parseFloat(val);
    setCSSVar('--radius', v + 'px');
    setCSSVar('--radius-sm', Math.max(2, v * 0.625) + 'px');
    setCSSVar('--radius-lg', (v * 1.25) + 'px');
    document.getElementById('valRadius').textContent = v + ' px';
  }

  function applyFont(val) {
    setCSSVar('--font-scale', parseFloat(val) / 100);
    document.getElementById('valFont').textContent = val + '%';
  }

  function resetTheme() {
    applyTheme(PRESETS.white);
    currentThemeKey = 'white';
    renderPresets();
    showToast('Тема сброшена', false);
  }

  function resetGeometry() {
    document.getElementById('sliderOpacity').value = 94;
    document.getElementById('sliderRadius').value = 8;
    document.getElementById('sliderFont').value = 100;
    applyOpacity(94); applyRadius(8); applyFont(100);
    showToast('Геометрия сброшена', false);
  }

  /* ============================================================
     AUCTION
     ============================================================ */
  let allLots = [];

  function startScan() {
    const btn = document.getElementById('scanBtn');
    const btnText = document.getElementById('scanBtnText');
    const fill = document.getElementById('progressFill');
    btn.classList.add('scanning');
    btnText.textContent = 'Сканирую...';
    fill.style.width = '0%';
    renderSkeletons();
    let progress = 0;
    const interval = setInterval(() => {
      progress += Math.random() * 14 + 4;
      if (progress >= 100) {
        progress = 100;
        clearInterval(interval);
        allLots = [];
        finishScan();
      }
      fill.style.width = progress + '%';
    }, 160);
  }

  function finishScan() {
    const btn = document.getElementById('scanBtn');
    const btnText = document.getElementById('scanBtnText');
    const fill = document.getElementById('progressFill');
    document.getElementById('statTotal').textContent = allLots.length;
    document.getElementById('statDeals').textContent = allLots.filter(l => (l.discount || 0) >= 20).length;
    document.getElementById('statTime').textContent = new Date().toLocaleTimeString('ru-RU', {hour: '2-digit', minute: '2-digit', second: '2-digit'});
    btn.classList.remove('scanning');
    btnText.textContent = 'Сканировать';
    setTimeout(() => fill.style.width = '0%', 500);
    renderLots();
    updateBadge();
  }

  function renderSkeletons() {
    const grid = document.getElementById('auctionGrid');
    let html = '';
    for (let i = 0; i < 6; i++) {
      html += `<div class="skel-card">
        <div class="skel-img"></div>
        <div class="skel-body">
          <div class="skel-line"></div>
          <div class="skel-line short"></div>
        </div>
      </div>`;
    }
    grid.innerHTML = html;
  }

  function renderLots() {
    const grid = document.getElementById('auctionGrid');
    if (allLots.length === 0) {
      grid.innerHTML = `
        <div class="empty-state" style="grid-column: 1 / -1;">
          <svg viewBox="0 0 24 24">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <div class="title">Нет данных</div>
          <div class="hint">Модуль JNI не получил лоты от игры.<br>После первого пакета карточки появятся здесь.</div>
        </div>`;
    }
  }

  function updateBadge() {
    const badge = document.getElementById('auctionBadge');
    const deals = allLots.filter(l => (l.discount || 0) >= 20).length;
    if (deals > 0) {
      badge.style.display = 'block';
      badge.textContent = deals;
    } else {
      badge.style.display = 'none';
    }
  }

  function toggleChk(el) {
    el.classList.toggle('on');
    renderLots();
  }

  /* ============================================================
     TOAST
     ============================================================ */
  let toastTimer = null;
  function showToast(text, isError) {
    const toast = document.getElementById('toast');
    document.getElementById('toastText').textContent = text;
    toast.classList.toggle('err', !!isError);
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 2000);
  }

  /* ============================================================
     ХОТКЕИ
     ============================================================ */
  document.addEventListener('keydown', e => {
    if (capturingEl) return;
    if (document.activeElement.tagName === 'INPUT') return;
    if (e.key === 'r' || e.key === 'R') startScan();
    if (e.key === 'Insert') {
      menuEl.style.display = menuEl.style.display === 'none' ? 'flex' : 'none';
    }
    if (e.key === 'Escape') closeModal();
  });

  /* ============================================================
     ПЕРЕТАСКИВАНИЕ
     ============================================================ */
  const titlebar = document.getElementById('titlebar');
  let dragging = false, ox = 0, oy = 0;

  titlebar.addEventListener('mousedown', e => {
    if (e.target.closest('#closeBtn') || e.target.closest('#minBtn')) return;
    dragging = true;
    ox = e.clientX - menuEl.offsetLeft;
    oy = e.clientY - menuEl.offsetTop;
  });

  document.addEventListener('mousemove', e => {
    if (!dragging) return;
    menuEl.style.left = (e.clientX - ox) + 'px';
    menuEl.style.top = (e.clientY - oy) + 'px';
  });

  document.addEventListener('mouseup', () => dragging = false);

  document.getElementById('closeBtn').addEventListener('click', () => menuEl.style.display = 'none');
  document.getElementById('minBtn').addEventListener('click', () => {
    const body = menuEl.querySelector('.body');
    const hidden = body.style.display === 'none';
    body.style.display = hidden ? 'flex' : 'none';
    menuEl.style.height = hidden ? '500px' : 'auto';
  });

  /* ============================================================
     INIT
     ============================================================ */
  resizeCanvas();
  initParticles();
  drawParticles();

  renderPresets();
  applyTheme(PRESETS.white);
  currentThemeKey = 'white';
  renderPresets();
  renderConfigs();
  renderLots();

  // Синхронизация чёрных карточек при старте
  document.querySelectorAll('.feature').forEach(feat => {
    const sw = feat.querySelector(':scope > .feature-head > .mini-sw');
    if (sw && sw.classList.contains('on')) {
      feat.classList.add('on');
    }
  });
</script>
