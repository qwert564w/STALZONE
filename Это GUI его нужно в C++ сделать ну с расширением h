      winBg: '#171717', sidebarBg: '#0a0a0a', panelBg: '#262626', inputBg: '#262626',
      border: 'rgba(255,255,255,0.08)', borderStrong: 'rgba(255,255,255,0.15)',
      text: '#e5e5e5', textBright: '#ffffff', textMid: '#d4d4d4', textDim: '#a3a3a3', textFaint: '#737373',
