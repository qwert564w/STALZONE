<script>
  /* ============================================================
     ЧАСТИЦЫ ВНУТРИ ОКНА
     ============================================================ */
  const menuEl = document.getElementById('menu');
  const particlesCanvas = document.getElementById('particles-canvas');
  const pCtx = particlesCanvas.getContext('2d');

  let particlesEnabled = true;
  let particlesCount = 40;
  let particlesSpeed = 1.0;
  let particlesLinks = 120;
  let particles = [];
  let mouse = { x: -9999, y: -9999 };
  let canvasW = 0, canvasH = 0;

  function resizeCanvas() {
    const rect = menuEl.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvasW = rect.width; canvasH = rect.height;
    particlesCanvas.width  = Math.max(1, Math.floor(canvasW * dpr));
    particlesCanvas.height = Math.max(1, Math.floor(canvasH * dpr));
    particlesCanvas.style.width  = canvasW + 'px';
    particlesCanvas.style.height = canvasH + 'px';
    pCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function getAccentColor() {
    return getComputedStyle(document.documentElement)
      .getPropertyValue('--accent-rgb').trim() || '71, 85, 105';
  }

  function initParticles() {
    particles = [];
    for (let i = 0; i < particlesCount; i++) {
      particles.push({
        x: Math.random() * canvasW,
        y: Math.random() * canvasH,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        r: 0.8 + Math.random() * 1.6
      });
    }
  }

  function drawParticles() {
    pCtx.clearRect(0, 0, canvasW, canvasH);
    if (!particlesEnabled) {
      requestAnimationFrame(drawParticles);
      return;
    }

    const accentRgb = getAccentColor();

    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];
      p.x += p.vx * particlesSpeed;
      p.y += p.vy * particlesSpeed;

      if (p.x < 0 || p.x > canvasW) p.vx *= -1;
      if (p.y < 0 || p.y > canvasH) p.vy *= -1;
      p.x = Math.max(0, Math.min(canvasW, p.x));
      p.y = Math.max(0, Math.min(canvasH, p.y));

      const dx = mouse.x - p.x, dy = mouse.y - p.y;
      const distMouse = Math.sqrt(dx*dx + dy*dy);
      if (distMouse < 140 && distMouse > 0.1) {
        const force = (140 - distMouse) / 140 * 0.02;
        p.vx += (dx / distMouse) * force;
        p.vy += (dy / distMouse) * force;
      }

      const sp = Math.sqrt(p.vx*p.vx + p.vy*p.vy);
      if (sp > 1.2) {
        p.vx = (p.vx / sp) * 1.2;
        p.vy = (p.vy / sp) * 1.2;
      }

      pCtx.beginPath();
      pCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      pCtx.fillStyle = `rgba(${accentRgb}, 0.6)`;
      pCtx.fill();
    }

    if (particlesLinks > 0) {
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const a = particles[i], b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < particlesLinks) {
            const alpha = (1 - dist / particlesLinks) * 0.24;
            pCtx.beginPath();
            pCtx.moveTo(a.x, a.y);
            pCtx.lineTo(b.x, b.y);
            pCtx.strokeStyle = `rgba(${accentRgb}, ${alpha})`;
            pCtx.lineWidth = 0.7;
            pCtx.stroke();
          }
        }
      }
    }

    requestAnimationFrame(drawParticles);
  }

  menuEl.addEventListener('mousemove', e => {
    const rect = menuEl.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
  });
  menuEl.addEventListener('mouseleave', () => {
    mouse.x = -9999;
    mouse.y = -9999;
  });

  new ResizeObserver(() => {
    resizeCanvas();
    initParticles();
  }).observe(menuEl);

  function toggleParticles(el) {
    el.classList.toggle('on');
    particlesEnabled = el.classList.contains('on');
    particlesCanvas.classList.toggle('hidden', !particlesEnabled);
    showToast(particlesEnabled ? 'Частицы включены' : 'Частицы выключены', false);
  }
  function applyParticlesCount(val) {
    particlesCount = parseInt(val);
    document.getElementById('valParticlesCount').textContent = particlesCount;
    initParticles();
  }
  function applyParticlesSpeed(val) {
    particlesSpeed = parseInt(val) / 10;
    document.getElementById('valParticlesSpeed').textContent = particlesSpeed.toFixed(1) + '×';
  }
  function applyParticlesLinks(val) {
    particlesLinks = parseInt(val);
    document.getElementById('valParticlesLinks').textContent = particlesLinks + ' px';
  }

  /* ============================================================
     ВКЛАДКИ
     ============================================================ */
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.querySelector(`.tab-panel[data-panel="${btn.dataset.tab}"]`).classList.add('active');
    });
  });

  /* ============================================================
     FEATURE
     ============================================================ */
  function toggleGear(el) {
    el.closest('.feature').classList.toggle('expanded');
  }

  function toggleFeature(el) {
    el.classList.toggle('on');
    const feat = el.closest('.feature');
    const status = feat.querySelector('[data-status]');
    const isOn = el.classList.contains('on');

    feat.classList.toggle('on', isOn);

    if (isOn) {
      if (feat.dataset.feature === 'panickey') {
        status.textContent = 'END';
      } else {
        status.textContent = 'вкл';
      }
      status.classList.add('on');
    } else {
      status.textContent = 'выкл';
      status.classList.remove('on');
    }
  }

  function toggleMini(el) {
    el.classList.toggle('on');
  }

  function updateSlider(input, fmt) {
    const row = input.closest('.slider-row-cfg');
    const valEl = row.querySelector('[data-val]');
    if (fmt) {
      valEl.textContent = fmt(parseFloat(input.value));
    } else {
      valEl.textContent = input.value;
    }
  }

  /* ============================================================
     KEYBIND CAPTURE
     ============================================================ */
  let capturingEl = null;
  const KEY_NAMES = {
    'Escape': 'ESC', 'Backspace': 'BKSP', 'Enter': 'ENTER', 'Tab': 'TAB',
    'Space': 'SPACE', 'ShiftLeft': 'LSHIFT', 'ShiftRight': 'RSHIFT',
    'ControlLeft': 'LCTRL', 'ControlRight': 'RCTRL', 'AltLeft': 'LALT', 'AltRight': 'RALT',
    'CapsLock': 'CAPS', 'Insert': 'INS', 'Delete': 'DEL', 'Home': 'HOME',
    'End': 'END', 'PageUp': 'PGUP', 'PageDown': 'PGDN',
    'ArrowUp': 'UP', 'ArrowDown': 'DOWN', 'ArrowLeft': 'LEFT', 'ArrowRight': 'RIGHT'
  };

  function codeToKeyName(code) {
    if (code.startsWith('Key')) return code.slice(3);
    if (code.startsWith('Digit')) return code.slice(5);
    if (code.startsWith('Numpad')) return 'NUM' + code.slice(6);
    if (/^F\d+$/.test(code)) return code;
    if (KEY_NAMES[code]) return KEY_NAMES[code];
    return code.toUpperCase();
  }

  function startCapture(el) {
    if (capturingEl && capturingEl !== el) {
      capturingEl.classList.remove('capturing');
      capturingEl.textContent = capturingEl.dataset.key || '—';
    }
    capturingEl = el;
    el.classList.add('capturing');
    el.textContent = '...';
  }

  document.addEventListener('keydown', e => {
    if (capturingEl) {
      e.preventDefault();
      e.stopPropagation();
      if (e.code === 'Escape') {
        capturingEl.classList.remove('capturing');
        capturingEl.textContent = capturingEl.dataset.key || '—';
        capturingEl = null;
        return;
      }
      if (e.code === 'Backspace') {
        capturingEl.classList.remove('capturing');
        capturingEl.dataset.key = '';
        capturingEl.textContent = '—';
        capturingEl = null;
        return;
      }
      const name = codeToKeyName(e.code);
      capturingEl.dataset.key = name;
      capturingEl.textContent = name;
      capturingEl.classList.remove('capturing');
      capturingEl = null;
      return;
    }
  });

  /* ============================================================
     CONFIG
     ============================================================ */
  let configs = [];
  let nextCfgId = 1;

  function renderConfigs() {
    const list = document.getElementById('cfgList');
    document.getElementById('cfgCount').textContent = `(${configs.length})`;
    if (configs.length === 0) {
      list.innerHTML = `<div class="cfg-empty">Нет сохранённых конфигов</div>`;
      return;
    }
    list.innerHTML = configs.map(cfg => `
      <div class="cfg-item ${cfg.active ? 'active' : ''}" onclick="loadConfig(${cfg.id})">
        <div class="cfg-ico">
          <svg viewBox="0 0 24 24">
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
            <polyline points="17 21 17 13 7 13 7 21"/>
          </svg>
        </div>
        <div class="cfg-meta">
          <div class="cfg-name">${escapeHtml(cfg.name)}</div>
          <div class="cfg-date">${cfg.date}${cfg.active ? ' · активен' : ''}</div>
        </div>
        <div class="cfg-actions">
          <div class="cfg-act" onclick="event.stopPropagation(); renameConfig(${cfg.id})" title="Переименовать">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <div class="cfg-act" onclick="event.stopPropagation(); duplicateConfig(${cfg.id})" title="Дублировать">
            <svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </div>
          <div class="cfg-act del" onclick="event.stopPropagation(); askDeleteConfig(${cfg.id})" title="Удалить">
            <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </div>
        </div>
      </div>
    `).join('');
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[c]);
  }

  function fmtDate(d) {
    return `${String(d.getDate()).padStart(2,'0')}.${String(d.getMonth()+1).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
  }

  function saveConfig() {
    const inp = document.getElementById('cfgNameInput');
    const name = inp.value.trim();
    if (!name) { showToast('Введи название', true); inp.focus(); return; }
    if (configs.some(c => c.name.toLowerCase() === name.toLowerCase())) {
      showToast('Такое имя уже есть', true); return;
    }
    configs.forEach(c => c.active = false);
    configs.unshift({ id: nextCfgId++, name, date: fmtDate(new Date()), active: true });
    inp.value = '';
    renderConfigs();
    showToast(`Конфиг "${name}" создан`, false);
  }

  function loadConfig(id) {
    const cfg = configs.find(c => c.id === id);
    if (!cfg) return;
    configs.forEach(c => c.active = false);
    cfg.active = true;
    renderConfigs();
    showToast(`Загружен: ${cfg.name}`, false);
  }

  function renameConfig(id) {
    const cfg = configs.find(c => c.id === id);
    if (!cfg) return;
    const newName = prompt('Новое название:', cfg.name);
    if (newName === null) return;
    const t = newName.trim();
    if (!t) { showToast('Пустое имя', true); return; }
    if (configs.some(c => c.id !== id && c.name.toLowerCase() === t.toLowerCase())) {
      showToast('Такое имя уже есть', true); return;
    }
    cfg.name = t;
    renderConfigs();
    showToast('Переименовано', false);
  }

  function duplicateConfig(id) {
    const cfg = configs.find(c => c.id === id);
    if (!cfg) return;
    let base = cfg.name + ' Copy', name = base, n = 2;
    while (configs.some(c => c.name === name)) name = base + ' ' + n++;
    configs.push({ id: nextCfgId++, name, date: fmtDate(new Date()), active: false });
    renderConfigs();
    showToast(`Создана копия: ${name}`, false);
  }

  let deleteTargetId = null;
  function askDeleteConfig(id) {
    const cfg = configs.find(c => c.id === id);
    if (!cfg) return;
    deleteTargetId = id;
    document.getElementById('modalTitle').textContent = 'Удалить конфиг?';
    document.getElementById('modalText').textContent = `Конфиг "${cfg.name}" будет удалён без возможности восстановления.`;
    document.getElementById('modalOverlay').classList.add('show');
  }

  function closeModal() {
    document.getElementById('modalOverlay').classList.remove('show');
    deleteTargetId = null;
  }

  document.getElementById('modalConfirm').addEventListener('click', () => {
    if (deleteTargetId !== null) {
      const cfg = configs.find(c => c.id === deleteTargetId);
      configs = configs.filter(c => c.id !== deleteTargetId);
      renderConfigs();
      showToast(`Удалён: ${cfg ? cfg.name : ''}`, false);
    }
    closeModal();
  });

  function overwriteConfig() {
    const active = configs.find(c => c.active);
    if (!active) { showToast('Нет активного конфига', true); return; }
    active.date = fmtDate(new Date());
    renderConfigs();
    showToast(`Перезаписан: ${active.name}`, false);
  }

  function exportConfig() {
    const data = {
      version: 1,
      configs,
      theme: currentTheme,
      customThemes,
      particles: {
        enabled: particlesEnabled,
        count: particlesCount,
        speed: particlesSpeed,
        links: particlesLinks
      }
    };
    console.log('[CONFIG EXPORT]\n' + JSON.stringify(data, null, 2));
    showToast('Экспорт в консоль (F12)', false);
  }

  function importConfig() {
    showToast('Импорт из файла — не реализовано', true);
  }

  /* ============================================================
     ТЕМЫ
     ============================================================ */
  const PRESETS = {
